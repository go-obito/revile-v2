APP_NAME=Revile API
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://revile:revile@localhost:5432/revile
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
FRONTEND_ORIGIN=http://localhost:3000
AKISMET_API_KEY=
AKISMET_BLOG_URL=https://revile.site
COOKIE_SECURE=false
IMAGEKIT_PUBLIC_KEY=replace-with-your-imagekit-public-key
IMAGEKIT_PRIVATE_KEY=replace-with-your-imagekit-private-key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
LOG_LEVEL=INFO
PUBLIC_DIR=public
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Revile Admin
